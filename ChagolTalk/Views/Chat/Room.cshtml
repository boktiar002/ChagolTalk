@{
    ViewData["Title"] = "Chat";
    var conversationId = ViewBag.ConversationId;
}

<div id="chatRoot" class="chat-page" data-conversation-id="@conversationId">

    <header class="chat-topbar">

        <div class="brand">
            <div class="brand-icon">🐐</div>
            <div class="brand-name">ChagolTalk</div>
        </div>

        <div class="stranger-info">

            <div class="avatar">👤</div>

            <div>
                <div class="stranger-name" id="strangerName">Stranger</div>

                <div class="status">
                    <span class="status-dot" id="statusDot"></span>
                    <span id="connectionStatus">Connecting...</span>
                </div>
            </div>

        </div>

        <div class="topbar-actions">

            <button id="reportButton" type="button" class="icon-button" title="Report this user" aria-label="Report">
                🚩
            </button>

            <button id="endButton" type="button" class="end-button">
                End conversation
            </button>

        </div>

    </header>

    <div id="reconnectBanner" class="reconnect-banner">
        <span class="spinner"></span>
        Stranger's connection dropped &mdash; waiting for them to come back...
    </div>

    <div class="call-launch-area">
        <button id="startCallButton" class="start-call-button">
            <span class="call-icon">📞</span>

            <span class="call-text">
                <strong>Start Voice Call</strong>
                <small>Talk with your stranger</small>
            </span>
        </button>
    </div>

    <!-- VOICE CALL SCREEN -->
    <div id="callScreen" class="call-screen" style="display:none;">

        <div id="callContent" class="call-content">

            <div class="call-avatar">👤</div>
            <div class="call-name" id="callName">Stranger</div>
            <div id="callStatus" class="call-status">Calling...</div>
            <div id="callTimer" class="call-timer" style="display:none;">00:00</div>

            <div class="call-controls">
                <button id="muteCallButton" type="button" class="call-control">🎙️</button>
                <button id="endCallButton" type="button" class="call-control end-call">☎</button>
            </div>

        </div>

        <div id="callEndedState" style="display:none;">
            <div>
                <div class="call-ended-icon">☎</div>
                <h2>Call ended</h2>
                <p id="callEndedMessage">The voice call has ended.</p>
                <button id="closeCallButton" type="button">Back to Chat</button>
            </div>
        </div>

    </div>

    <!-- INCOMING VOICE CALL SCREEN -->
    <div id="incomingCallScreen" class="call-screen" style="display:none;">

        <div class="call-content">

            <div class="call-avatar incoming-avatar">👤</div>
            <div class="call-name" id="incomingCallName">Stranger</div>
            <div class="call-status">Incoming voice call...</div>

            <div class="incoming-controls">
                <button id="declineCallButton" type="button" class="call-control decline-call">✕</button>
                <button id="acceptCallButton" type="button" class="call-control accept-call">📞</button>
            </div>

        </div>

    </div>

    <!-- MESSAGES -->
    <main id="messages" class="messages">

        <div id="systemMessage" class="system-message">
            Connecting you to the conversation...
        </div>

        <div class="empty-hint" id="emptyHint">
            <div class="big">💬</div>
            <p>Say hello. You never know where the conversation might go.</p>
        </div>

        <div id="typingIndicator" class="typing-indicator">
            <span></span><span></span><span></span>
        </div>

    </main>

    <div id="endedScreen" class="ended-screen" style="display:none;">

        <div class="ended-card">

            <div class="ended-icon">👋</div>
            <h2>Conversation ended</h2>
            <p id="endedMessage">Your stranger left the conversation.</p>

            <div class="ended-actions">
                <button id="findAnotherButton" type="button">Find Someone</button>
                <button id="reportFromEndedButton" type="button">Report user</button>
            </div>

        </div>

    </div>

    <!-- COMPOSER -->
    <div id="composerWrap" class="composer-wrap">

        <div class="composer">

            <input id="messageInput"
                   type="text"
                   maxlength="2000"
                   placeholder="Say something..."
                   autocomplete="off" />

            <button id="sendButton" aria-label="Send message">
                <span class="send-icon">➤</span>
            </button>

        </div>

    </div>

</div>

<!-- REPORT MODAL -->
<div id="reportModal" class="modal-overlay">

    <div class="modal-card">

        <h3>Report this stranger</h3>
        <p class="modal-sub">Your report is anonymous. Repeated reports may restrict their account.</p>

        <div class="report-reasons">
            <button type="button" class="report-reason" data-reason="1">Harassment</button>
            <button type="button" class="report-reason" data-reason="2">Sexual content</button>
            <button type="button" class="report-reason" data-reason="3">Hate speech</button>
            <button type="button" class="report-reason" data-reason="4">Spam / scam</button>
            <button type="button" class="report-reason" data-reason="5">Underage user</button>
            <button type="button" class="report-reason" data-reason="6">Threats</button>
            <button type="button" class="report-reason" data-reason="0" style="grid-column:span 2;">Other</button>
        </div>

        <textarea id="reportDetails" placeholder="Anything else we should know? (optional)"></textarea>

        <div class="modal-actions">
            <button id="cancelReportButton" type="button">Cancel</button>
            <button id="confirmReportButton" type="button" disabled>Submit report</button>
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
