@model ChagolTalk.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-card card">

    <div class="dashboard-avatar">👤</div>

    <h1>Welcome back, @(Model.User.DisplayName ?? Model.User.UserName)</h1>
    <p class="text-muted">Ready to meet someone new?</p>

    <div class="dashboard-stats">

        <div class="stat-box">
            <div class="stat-value">@Model.RecentConversationCount</div>
            <div class="stat-label">Conversations</div>
        </div>

        <div class="stat-box">
            <div class="stat-value">@Model.FormattedVoiceTime</div>
            <div class="stat-label">Voice time</div>
        </div>

        <div class="stat-box">
            <div class="stat-value">@Model.OnlineCount</div>
            <div class="stat-label">Online now</div>
        </div>

    </div>

    <div class="dashboard-actions">

        <a asp-controller="Chat" asp-action="Start" class="btn btn-primary btn-lg">
            🎙️ Start Chatting
        </a>

        <a asp-controller="Account" asp-action="EditProfile" class="btn btn-nav">
            Edit Profile
        </a>

    </div>

    <form asp-controller="Account" asp-action="Logout" method="post" class="dashboard-logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Logout</button>
    </form>

</div>
