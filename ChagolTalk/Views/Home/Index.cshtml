@{
    ViewData["Title"] = "Welcome";
    int onlineCount = ViewBag.OnlineCount ?? 0;
    int estimatedWaitSeconds = ViewBag.EstimatedWaitSeconds ?? 15;
    int peopleTalking = ViewBag.PeopleTalking ?? 0;
    string? quickStartError = ViewBag.QuickStartError as string;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="hero">

    <div class="hero-badge">
        🎙️ Voice-first random chat &middot;
        <span style="color:var(--success);">&#9679;</span>
        @onlineCount online now
    </div>

    <h1 class="hero-title">
        Talk to a Stranger.<br>
        Actually Talk.
    </h1>

    <p class="hero-description">
        ChagolTalk pairs you with a random person for a live voice conversation &mdash;
        texting is there too, but the mic is the main event.
        No account needed. Just a name and one click.
    </p>

    <div class="live-stats-row">
        <span><span class="live-dot"></span> @onlineCount online</span>
        <span>&#9201; usually matches in ~@(estimatedWaitSeconds)s</span>
        <span>&#128172; @peopleTalking people talking now</span>
    </div>

    <div class="hero-buttons">

        @if (isAuthenticated)
        {
            <a asp-controller="Chat" asp-action="Start" class="btn btn-primary btn-lg">
                🎙️ Start Talking
            </a>
        }
        else
        {
            <button type="button" id="openQuickStartButton" class="btn btn-primary btn-lg">
                🎙️ Start Talking Now
            </button>

            <a asp-controller="Account" asp-action="Login" class="btn btn-nav btn-lg">
                Already have an account?
            </a>
        }

    </div>

</section>


<section class="how-it-works">

    <div class="step-card">
        <div class="step-number">1</div>
        <h3>Type your name</h3>
        <p>No email, no password. Just tell us what to call you.</p>
    </div>

    <div class="step-card">
        <div class="step-number">2</div>
        <h3>Get matched instantly</h3>
        <p>Our matcher pairs you with someone online right now &mdash; usually in seconds.</p>
    </div>

    <div class="step-card">
        <div class="step-number">3</div>
        <h3>Talk, live</h3>
        <p>One tap starts a real-time voice call. Not feeling it? Skip to the next stranger.</p>
    </div>

</section>


<section class="features">

    <div class="feature-card">
        <div class="feature-icon">🎙️</div>
        <h3>Real Voice Calls</h3>
        <p>Peer-to-peer voice powered by WebRTC. Low latency, no recordings kept.</p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Instant Matching</h3>
        <p>Find someone to talk to in seconds, filtered by shared interests.</p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Private by Design</h3>
        <p>Conversations end permanently when you leave. Report anyone, anytime.</p>
    </div>

</section>

@if (!isAuthenticated)
{
    <!-- QUICK START MODAL -->
    <div id="quickStartModal" class="modal-overlay">

        <div class="modal-card">

            <h3>What should we call you?</h3>
            <p class="modal-sub">No account needed &mdash; just start talking.</p>

            <form asp-controller="Account" asp-action="QuickStart" method="post" id="quickStartForm">

                @Html.AntiForgeryToken()

                <input type="text"
                       name="DisplayName"
                       id="quickStartName"
                       class="form-control mb-3"
                       placeholder="Your name"
                       maxlength="20"
                       autocomplete="off"
                       required />

                <p id="quickStartError" class="quick-start-error" style="display:@(string.IsNullOrEmpty(quickStartError) ? "none" : "block");">
                    @quickStartError
                </p>

                <div class="modal-actions">
                    <button type="button" id="cancelQuickStartButton">Cancel</button>
                    <button type="submit" id="confirmQuickStartButton">Start Matching &rarr;</button>
                </div>

            </form>

        </div>

    </div>
}

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>

    @if (!string.IsNullOrEmpty(quickStartError))
    {
        <script>document.addEventListener("DOMContentLoaded", () => window.__ctOpenQuickStart && window.__ctOpenQuickStart());</script>
    }
}
