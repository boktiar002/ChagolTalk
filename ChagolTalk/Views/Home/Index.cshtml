@{
    ViewData["Title"] = "Welcome";
    int onlineCount = ViewBag.OnlineCount ?? 0;
    int estimatedWaitSeconds = ViewBag.EstimatedWaitSeconds ?? 15;
    int peopleTalking = ViewBag.PeopleTalking ?? 0;
    string? quickStartError = ViewBag.QuickStartError as string;

    // Carried back from a failed submit so the modal reopens filled in.
    string? quickStartName = ViewBag.QuickStartName as string;
    string? quickStartYear = ViewBag.QuickStartYear as string;

    // Latest year that clears the age floor -- the browser rejects anything
    // later without a round trip to the server.
    int latestBirthYear = DateTime.UtcNow.Year - AppSettings.MinimumAge;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="hero">

    <div class="hero-badge">
        🎙️ Everyone has a story you haven't heard yet.
    </div>

    <h1 class="hero-title">
        Talk to a stranger.<br>
        <span class="accent">You might leave knowing yourself a little better.</span>
    </h1>

    <p class="hero-description">
        No swiping. No judging. No expectations.
        Just a real conversation with someone you've never met.
    </p>

    <div class="live-stats-row">
        <span><span class="live-dot"></span> @onlineCount online</span>
        <span>&#9201; usually matches in ~@(estimatedWaitSeconds)s</span>
        <span>&#128172; @peopleTalking people talking now</span>
    </div>

    <div class="hero-buttons">

        @if (isAuthenticated)
        {
            <a asp-controller="Chat" asp-action="Start" class="btn btn-primary btn-lg">
                🎙️ Start Talking
            </a>
        }
        else
        {
            <button type="button" id="openQuickStartButton" class="btn btn-primary btn-lg">
                🎙️ Start Talking Now
            </button>

            <a asp-controller="Account" asp-action="Login" class="btn btn-nav btn-lg">
                Have an account? Log in
            </a>
        }

    </div>

</section>


<section class="how-it-works">

    <div class="step-card">
        <div class="step-number">1</div>
        <h3>Say your name</h3>
        <p>No signup, no password &mdash; just tell us what to call you.</p>
    </div>

    <div class="step-card">
        <div class="step-number">2</div>
        <h3>Get matched instantly</h3>
        <p>We pair you with someone online right now &mdash; usually in seconds.</p>
    </div>

    <div class="step-card">
        <div class="step-number">3</div>
        <h3>Talk, live</h3>
        <p>One tap starts a real voice call. Not vibing? Skip to the next stranger instantly.</p>
    </div>

</section>


<section class="features">

    <div class="feature-card">
        <div class="feature-icon">🎙️</div>
        <h3>Real Voice Calls</h3>
        <p>Peer-to-peer voice powered by WebRTC. Low latency, nothing recorded.</p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Instant Matching</h3>
        <p>Find someone to talk to in seconds, matched by shared interests.</p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Private by Design</h3>
        <p>Conversations disappear when you leave. Report anyone, anytime.</p>
    </div>

</section>

@if (!isAuthenticated)
{
    <!-- QUICK START MODAL -->
    <div id="quickStartModal" class="modal-overlay">

        <div class="modal-card">

            <h3>What should we call you?</h3>
            <p class="modal-sub">No account needed &mdash; just start talking.</p>

            <form asp-controller="Account" asp-action="QuickStart" method="post" id="quickStartForm">

                @Html.AntiForgeryToken()

                <input type="text"
                       name="DisplayName"
                       id="quickStartName"
                       class="form-control mb-3"
                       placeholder="Your name"
                       aria-label="Your name"
                       autocomplete="off"
                       maxlength="20"
                       value="@quickStartName"
                       required />

                <input type="number"
                       name="BirthYear"
                       id="quickStartYear"
                       class="form-control mb-3"
                       placeholder="Year you were born"
                       aria-label="Year you were born"
                       inputmode="numeric"
                       autocomplete="off"
                       data-min-age="@AppSettings.MinimumAge"
                       min="1900"
                       max="@latestBirthYear"
                       value="@quickStartYear"
                       required />

                <p id="quickStartError" class="quick-start-error" style="display:@(string.IsNullOrEmpty(quickStartError) ? "none" : "block");">
                    @quickStartError
                </p>

                <div class="modal-actions">
                    <button type="button" id="cancelQuickStartButton">Cancel</button>
                    <button type="submit" id="confirmQuickStartButton">Start Matching &rarr;</button>
                </div>

            </form>

        </div>

    </div>
}

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>

    @if (!string.IsNullOrEmpty(quickStartError))
    {
        <script>document.addEventListener("DOMContentLoaded", () => window.__ctOpenQuickStart && window.__ctOpenQuickStart());</script>
    }
}
