@using ChagolTalk.Models.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser? currentUser = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppSettings.AppName</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lobby.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg ct-navbar">

            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-goat">🐐</span> ChagolTalk
                </a>

                <div class="ms-auto d-flex align-items-center">

                    @if (currentUser != null && currentUser.IsGuest)
                    {
                        <a class="guest-chip" asp-controller="Dashboard" asp-action="Index" title="Your session">
                            <span class="guest-chip-avatar">👤</span>
                            <span class="guest-chip-name">@currentUser.DisplayName</span>
                            <span class="guest-chip-tag">Guest</span>
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              id="logoutForm">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="nav-text-link"
                                    id="logoutButton">
                                End session
                            </button>

                        </form>
                    }
                    else if (currentUser != null)
                    {
                        <a class="btn btn-nav me-2"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Dashboard
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              id="logoutForm">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger"
                                    id="logoutButton">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="nav-text-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Have an account? <strong>Login</strong>
                        </a>
                    }

                </div>

            </div>

        </nav>

    </header>

    <main class="ct-main">

        @RenderBody()

    </main>

    <footer class="ct-footer">

        <div class="container">

            © 2026 @AppSettings.Company
            &middot;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
