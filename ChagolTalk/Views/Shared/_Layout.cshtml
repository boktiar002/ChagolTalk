@using ChagolTalk.Helpers
@using ChagolTalk.Models.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = User.Identity?.IsAuthenticated == true;

    // Read from the auth cookie rather than the database. Drawing this navbar
    // used to cost a round trip to Postgres on every page view.
    var displayName = User.DisplayNameOrNull();
    var isGuest = User.IsGuestOrNull() ?? false;

    // Cookies issued before those claims existed do not carry them, so those
    // sessions -- and only those -- still pay for one lookup until the cookie
    // expires and is reissued with the claims.
    if (signedIn && displayName is null)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        displayName = currentUser?.DisplayName ?? currentUser?.UserName;
        isGuest = currentUser?.IsGuest ?? false;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @* viewport-fit=cover lets the page paint into the notch and home-indicator
       areas, and is what makes env(safe-area-inset-*) report real values.
       Without it those insets are always 0 and every layout that reads them
       silently does nothing -- which was the case here. The --safe-* variables
       in site.css depend on this. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - @AppSettings.AppName</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lobby.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg ct-navbar">

            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-goat">🐐</span> <span class="brand-text">ChagolTalk</span>
                </a>

                <div class="ms-auto d-flex align-items-center">

                    @if (signedIn && isGuest)
                    {
                        <a class="guest-chip" asp-controller="Dashboard" asp-action="Index" title="Your session">
                            <span class="guest-chip-avatar">👤</span>
                            <span class="guest-chip-name">@displayName</span>
                            <span class="guest-chip-tag">Guest</span>
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              id="logoutForm">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="nav-text-link"
                                    id="logoutButton">
                                End session
                            </button>

                        </form>
                    }
                    else if (signedIn)
                    {
                        <a class="btn btn-nav me-2"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Dashboard
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              id="logoutForm">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger"
                                    id="logoutButton">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="nav-text-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Have an account? <strong>Login</strong>
                        </a>
                    }

                </div>

            </div>

        </nav>

    </header>

    <main class="ct-main">

        @RenderBody()

    </main>

    <footer class="ct-footer">

        <div class="container">

            © 2026 @AppSettings.Company
            &middot;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>

        </div>

    </footer>

    @* Three scripts used to load on every page here and none of them earned it.

       Bootstrap's JS is not referenced anywhere -- no data-bs-* attributes, no
       calls into its API; the modals in this app are hand-written. site.js has
       never contained anything but the template's placeholder comment. jQuery
       is only needed by the three pages that render _ValidationScriptsPartial,
       so it now loads from there, immediately before the validation plugins
       that depend on it.

       That is roughly 170KB of JavaScript removed from the home page, the
       lobby and the chat room -- the pages that matter most on a slow phone. *@
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
